# Airtable
AIRTABLE_API_KEY=patXXXXXXXXX.XXXXX...
AIRTABLE_BASE_ID=appkUqBmwhAK9F8AX

# Supabase (Auth + 유저 데이터)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# Supabase 서버 전용 (RLS 우회 — 절대 NEXT_PUBLIC_ 접두사 금지, Vercel에서는 Sensitive로 등록)
SUPABASE_SERVICE_ROLE_KEY=

# RevenueCat (구독/인앱결제, Android) — 코드·웹훅은 유지, UI는 아래 플래그가 켤 때만 노출
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_XXXXXXXXXXXXXXXXXXXXXXXX
# 웹훅 Authorization 헤더 값과 동일하게 (서버 전용)
REVENUECAT_WEBHOOK_SECRET=

# 결제 화면 스위치. 무료 출시는 false(또는 미설정).
# true 이면 /upgrade 가 다시 보인다. 이용약관 문구는 바꾸지 않는다.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# AI 추천 LLM 보조 (선택 — 없으면 규칙 엔진만 사용, 서버 전용)
ANTHROPIC_API_KEY=

# 옵션
NEXT_PUBLIC_APP_NAME=bjj-app
