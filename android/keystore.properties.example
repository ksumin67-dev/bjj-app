# 복사해서 android/keystore.properties 로 저장하세요.
# keystore.properties 는 gitignore 대상입니다. 비밀번호를 커밋하지 마세요.
# 키스토어 파일은 이 저장소 밖에 두세요. 상대 경로는 android/ 기준입니다.
# 같은 항목의 환경변수가 있으면 환경변수가 우선합니다.
# 비밀번호에 # ! \ 가 들어가면 properties 이스케이프 대신 환경변수를 쓰세요.
#
#   ANDROID_UPLOAD_STORE_FILE
#   ANDROID_UPLOAD_STORE_PASSWORD
#   ANDROID_UPLOAD_KEY_ALIAS
#   ANDROID_UPLOAD_KEY_PASSWORD
#
# 절차: docs/android_play_signing.md

storeFile=
storePassword=
keyAlias=
keyPassword=
